[Unit]
Description=vLLM - Qwen3.8-27B NVFP4 on DGX Spark
Documentation=https://github.com/Bitbull-Ideas/vllm.qwen3.8-27b
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/srv/vllm3
ExecStart=/srv/vllm3/vllm-server.sh
Environment=HOST=0.0.0.0
Environment=PORT=8000
Environment=MODEL_REPO=RadixArk/Qwen3.8-27B-NVFP4
Environment=SERVED_MODEL_NAME=Qwen/Qwen3.8-27B
Environment=MAX_MODEL_LEN=262144
Environment=GPU_MEM_UTIL=0.50
Environment=KV_CACHE_DTYPE=fp8
Environment=NUM_SPEC_TOKENS=3
Environment=LANGUAGE_ONLY=false
Restart=on-failure
RestartSec=15
TimeoutStartSec=infinity
TimeoutStopSec=120
KillSignal=SIGTERM
MemoryAccounting=yes
MemoryHigh=55%
MemoryMax=60%
OOMPolicy=stop
LimitNOFILE=65536
LimitNPROC=4096

[Install]
WantedBy=default.target
